# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM=EmailCorreto <noreply@emailcorreto.com.br>

# App (backend)
# APP_URL = URL do FRONTEND (Cloudflare Pages) — usada nos links do e-mail e nas
# success_url/cancel_url do Stripe. NÃO é a URL do backend.
APP_URL=http://localhost:5173
PORT=3001

# Origens permitidas no CORS (CSV). Em produção: a URL do Pages (+ domínio final).
ALLOWED_ORIGINS=http://localhost:5173,https://email-fixer-website.pages.dev

# ─── Frontend (build do Vite / Cloudflare Pages) ─────────────────────────────
# Base das chamadas de API. Em DEV deixe VAZIO (usa o proxy /api do Vite).
# Em PRODUÇÃO (Cloudflare Pages) aponte para o backend no Fly, ex.:
#   VITE_API_BASE=https://emailcorreto-api.fly.dev
VITE_API_BASE=
